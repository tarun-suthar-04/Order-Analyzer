<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for Firebase Auth and Firestore sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        WRITE_EXTERNAL_STORAGE is needed only on API 28 and below
        to export the summary CSV to the Downloads folder.
        On API 29+, MediaStore is used instead (no permission needed).
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OrderAnalyzer">

        <!-- ── Home Screen (launcher) ── -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── Amul Milk Orders (separate CSV/Excel analysis screen) ── -->
        <activity
            android:name=".AmulMilkOrdersActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HomeActivity" />

        <!-- ── Shop Authentication (Login ID / Password) ── -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".HomeActivity" />

        <!-- ── Shop Profile / Account & Sync Status ── -->
        <activity
            android:name=".ShopProfileActivity"
            android:exported="false"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <!-- ── Daily Product Orders Module ── -->
        <activity
            android:name=".DailyProductOrdersActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".HomeActivity" />

        <activity
            android:name=".AddRetailerOrderActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <activity
            android:name=".ProductTotalsActivity"
            android:exported="false"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <activity
            android:name=".TodayRetailersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <activity
            android:name=".PendingOrdersActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <activity
            android:name=".RetailerOrderDetailActivity"
            android:exported="false"
            android:parentActivityName=".TodayRetailersActivity" />

        <activity
            android:name=".AddRetailerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".RetailersManagementActivity" />

        <activity
            android:name=".ProductsManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <activity
            android:name=".RetailersManagementActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".DailyProductOrdersActivity" />

        <activity
            android:name=".OrderHistoryActivity"
            android:exported="false"
            android:parentActivityName=".DailyProductOrdersActivity" />

    </application>

</manifest>
