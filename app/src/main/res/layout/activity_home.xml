<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="34dp"
        android:paddingEnd="24dp"
        android:paddingBottom="36dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/img_order_manager_logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="60dp"
                android:layout_marginStart="14dp"
                android:gravity="center_vertical"
                android:text="Order Manager"
                android:textColor="#071126"
                android:textSize="27sp"
                android:fontFamily="sans-serif-black"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="44dp"
            android:text="WELCOME BACK"
            android:textColor="#71809A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.18" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Manage Orders&#10;Effortlessly"
                android:textColor="#050D20"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black"
                android:lineSpacingExtra="-2dp" />

            <TextView
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:paddingBottom="4dp"
                android:text="Simple.&#10;Organized.&#10;Productive.&#10;—"
                android:textColor="#71809A"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.15" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_amul_milk"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="26dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Amul Milk Orders"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_card_amul" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:id="@+id/card_daily_product"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="18dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Daily Product Orders"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/bg_card_daily" />
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
