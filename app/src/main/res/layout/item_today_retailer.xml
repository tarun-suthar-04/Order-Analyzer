<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_retailer_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_avatar_initial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:text="R"
        android:textColor="@color/brand_blue"
        android:textSize="16sp"
        android:fontFamily="sans-serif-bold"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_retailer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rupal B Modi"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-bold"/>

        <TextView
            android:id="@+id/tv_item_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="25 items"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"/>
    </LinearLayout>

    <ImageButton
        android:id="@+id/btn_edit_retailer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_pill_today"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit"
        app:tint="@color/brand_blue"/>

    <ImageButton
        android:id="@+id/btn_delete_retailer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_quantity_box"
        android:src="@drawable/ic_delete"
        android:contentDescription="Delete"
        app:tint="@color/danger_red"/>
</LinearLayout>
