<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_login"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="Back"
                android:padding="10dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:fontFamily="sans-serif-bold"
                android:text="Shop Account"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/login_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Friendly branded hero panel -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="208dp"
                app:cardBackgroundColor="#EAF4FF"
                app:cardCornerRadius="28dp"
                app:cardElevation="1dp"
                app:cardUseCompatPadding="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="22dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="start|center_vertical"
                        android:layout_marginEnd="140dp"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.18"
                            android:text="WELCOME TO"
                            android:textColor="#7184AD"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-bold"
                            android:lineSpacingExtra="-3dp"
                            android:text="Order\nAnalyzer"
                            android:textColor="#101B48"
                            android:textSize="32sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Daily product Order"
                            android:textColor="#7184AD"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="132dp"
                        android:layout_height="92dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="-4dp"
                        android:alpha="0.9"
                        android:background="@drawable/bg_auth_decor_purple"
                        android:rotation="-28" />

                    <View
                        android:layout_width="56dp"
                        android:layout_height="40dp"
                        android:layout_gravity="end|bottom"
                        android:layout_marginEnd="4dp"
                        android:alpha="0.9"
                        android:background="@drawable/bg_auth_decor_yellow"
                        android:rotation="-20" />

                    <FrameLayout
                        android:layout_width="132dp"
                        android:layout_height="146dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_auth_illustration">

                        <ImageView
                            android:layout_width="98dp"
                            android:layout_height="98dp"
                            android:layout_gravity="center"
                            android:contentDescription="Shop"
                            android:padding="12dp"
                            android:src="@drawable/ic_store_outline"
                            app:tint="@color/brand_blue" />

                        <TextView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_gravity="top|center_horizontal"
                            android:background="@drawable/bg_auth_number_badge"
                            android:gravity="center"
                            android:text="24"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-bold" />
                    </FrameLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Login form -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="24dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Login ID"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_badge_blue">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center"
                                android:contentDescription="Login ID"
                                android:src="@drawable/ic_person_outline"
                                app:tint="@color/brand_blue" />
                        </FrameLayout>

                        <EditText
                            android:id="@+id/et_login_id"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:autofillHints="username"
                            android:background="@drawable/bg_auth_input"
                            android:hint="Enter Login ID (e.g. shree_bakery)"
                            android:imeOptions="actionNext"
                            android:inputType="textNoSuggestions"
                            android:maxLines="1"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:selectAllOnFocus="false"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Password"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="46dp"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_auth_badge_purple">

                            <ImageView
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center"
                                android:contentDescription="Password"
                                android:src="@drawable/ic_lock_outline"
                                app:tint="@color/pastel_purple_icon" />
                        </FrameLayout>

                        <FrameLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1">

                            <EditText
                                android:id="@+id/et_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:autofillHints="password"
                                android:background="@drawable/bg_auth_input"
                                android:hint="Enter Password"
                                android:imeOptions="actionDone"
                                android:inputType="textPassword"
                                android:maxLines="1"
                                android:paddingStart="14dp"
                                android:paddingEnd="48dp"
                                android:textColor="@color/text_primary"
                                android:textColorHint="@color/text_muted"
                                android:textSize="14sp" />

                            <ImageButton
                                android:id="@+id/btn_password_visibility"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="end|center_vertical"
                                android:background="@android:color/transparent"
                                android:contentDescription="Show password"
                                android:padding="12dp"
                                android:src="@drawable/ic_visibility_off"
                                app:tint="@color/text_secondary" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_forgot_password"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_gravity="end"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="4dp"
                        android:text="Forgot Password?"
                        android:textColor="@color/brand_blue"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="4dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_login"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_btn_primary"
                            android:drawableStart="@drawable/ic_login_arrow"
                            android:drawablePadding="12dp"
                            android:fontFamily="sans-serif-bold"
                            android:gravity="center"
                            android:stateListAnimator="@null"
                            android:text="LOG IN"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="16sp" />

                        <ProgressBar
                            android:id="@+id/progress_login"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="OR"
                            android:textColor="@color/text_muted"
                            android:textSize="13sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@color/divider" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_create_account"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_btn_outline"
                        android:drawableStart="@drawable/ic_store_outline"
                        android:drawablePadding="10dp"
                        android:fontFamily="sans-serif-bold"
                        android:gravity="center"
                        android:stateListAnimator="@null"
                        android:text="CREATE SHOP ACCOUNT"
                        android:textAllCaps="false"
                        android:textColor="@color/brand_blue"
                        android:textSize="14sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
