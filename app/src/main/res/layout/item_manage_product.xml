<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/tv_product_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_pill_today"
        android:gravity="center"
        android:text="📦"
        android:textSize="18sp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_product_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gold Coin"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tv_product_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="₹15.00"
            android:textColor="@color/brand_blue"
            android:textSize="12sp"
            android:fontFamily="sans-serif-bold"/>
    </LinearLayout>

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/switch_product_active"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:thumbTint="@color/white"
        app:trackTint="@color/switch_track_tint"
        android:checked="true"/>

    <ImageButton
        android:id="@+id/btn_edit_product"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_pill_today"
        android:src="@drawable/ic_edit"
        android:contentDescription="Edit"
        app:tint="@color/brand_blue"/>

    <ImageButton
        android:id="@+id/btn_delete_product"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_quantity_box"
        android:src="@drawable/ic_delete"
        android:contentDescription="Deactivate"
        app:tint="@color/danger_red"/>
</LinearLayout>
